<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Radio Admin Upload</title>
</head>
<body>

<h2>Oluwa-Timileyin Radio – Admin</h2>

<input type="file" id="file" accept="audio/*">
<br><br>
<button onclick="upload()">Upload Audio</button>

<p id="status"></p>

<script>
const API = "https://oluwa-timileyin-radio-backend-jgwk.onrender.com";

function upload() {
  const fileInput = document.getElementById("file");
  const status = document.getElementById("status");

  if (!fileInput.files.length) {
    status.innerText = "Select an audio file first";
    return;
  }

  const formData = new FormData();
  formData.append("audio", fileInput.files[0]);

  fetch(API + "/admin/upload", {
    method: "POST",
    body: formData
  })
  .then(res => res.json())
  .then(() => {
    status.innerText = "Upload successful ✅";
  })
  .catch(() => {
    status.innerText = "Upload failed ❌";
  });
}
</script>

</body>
</html>
