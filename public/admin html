<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Radio Admin Upload</title>
</head>
<body>

<h2>Oluwa-Timileyin Radio – Admin Upload</h2>

<input type="file" id="audioFile" accept="audio/*">
<br><br>
<button onclick="upload()">Upload Audio</button>

<p id="msg"></p>

<script>
const BACKEND = "https://oluwa-timileyin-radio-backend-jgwk.onrender.com";

function upload() {
  const fileInput = document.getElementById("audioFile");
  const msg = document.getElementById("msg");

  if (!fileInput.files.length) {
    msg.innerText = "Please select an audio file";
    return;
  }

  const formData = new FormData();
  formData.append("audio", fileInput.files[0]);

  fetch(BACKEND + "/admin/upload", {
    method: "POST",
    body: formData
  })
  .then(res => res.json())
  .then(data => {
    msg.innerText = "Upload successful ✔";
  })
  .catch(err => {
    msg.innerText = "Upload failed ❌";
  });
}
</script>

</body>
</html>
